<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>系统设置</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/nav', { navTitle: '周报管理后台', activeNav: 'settings', adminNav: true }) %>

<div class="container">
  <% if (flash) { %>
    <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
  <% } %>

  <form method="POST" action="/admin/settings">
    <div class="settings-top-actions">
      <button type="submit" class="btn btn-primary">保存全部设置</button>
      <span class="hint-text">修改任意配置后点击这里统一保存。</span>
    </div>

    <!-- 周期与账号规则 -->
    <div class="card">
      <div class="card-header">
        <h2>周期与账号规则</h2>
      </div>
      <div class="card-body">
        <p class="hint-text" style="font-size:14px; line-height:1.8">
          本周工作和下周计划合并为一个周期，周期按周一至周日计算。当前周期可查看和修改，上一周期及更早记录仅可查看。
        </p>
        <div class="form-group" style="margin-top:14px">
          <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:15px">
            <input type="checkbox" name="email_required" value="1"
                   <%= (settings.email_required || '0') === '1' ? 'checked' : '' %>
                   style="width:18px;height:18px">
            <span>强制用户绑定邮箱</span>
          </label>
          <small class="hint-text">开启后，用户登录后必须填写邮箱；首次登录仍会强制修改初始密码。</small>
        </div>
      </div>
    </div>

    <!-- AI 服务商配置 -->
    <div class="card">
      <div class="card-header">
        <h2>AI 服务商配置</h2>
        <button type="button" class="btn btn-secondary" onclick="addProviderCard()">添加 API 服务商</button>
      </div>
      <div class="card-body">
        <div id="provider-list" class="provider-list"></div>
        <small class="hint-text">按“当前 API 优先级”从小到大轮询；同一服务商内按“模型顺序”从左到右尝试。</small>
      </div>
    </div>

    <!-- SMTP 配置 -->
    <div class="card">
      <div class="card-header">
        <h2>SMTP 邮箱发送</h2>
      </div>
      <div class="card-body">
        <div class="form-grid">
          <div class="form-group">
            <label>SMTP Host</label>
            <input type="text" name="smtp_host" value="<%= settings.smtp_host || '' %>" placeholder="smtp.example.com">
          </div>
          <div class="form-group">
            <label>端口</label>
            <input type="number" name="smtp_port" value="<%= settings.smtp_port || '465' %>" min="1">
          </div>
          <div class="form-group">
            <label>账号</label>
            <input type="text" name="smtp_user" value="<%= settings.smtp_user || '' %>">
          </div>
          <div class="form-group">
            <label>密码 / 授权码</label>
            <input type="password" name="smtp_pass" value="<%= settings.smtp_pass || '' %>">
          </div>
          <div class="form-group">
            <label>发件人</label>
            <input type="text" name="smtp_from" value="<%= settings.smtp_from || '' %>" placeholder="周报系统 <weekly@example.com>">
          </div>
          <div class="form-group">
            <label>测试收件人</label>
            <input type="email" id="test-email" placeholder="name@example.com">
          </div>
          <div class="form-group">
            <label style="display:flex; align-items:center; gap:8px; cursor:pointer; margin-top:28px">
              <input type="checkbox" name="smtp_secure" value="1" <%= (settings.smtp_secure || '1') === '1' ? 'checked' : '' %> style="width:18px;height:18px">
              <span>启用 SSL/TLS</span>
            </label>
          </div>
        </div>
        <div class="form-actions smtp-test-actions">
          <button type="button" class="btn btn-secondary" onclick="testSmtp()">发送测试邮件</button>
          <span id="smtp-test-result" class="hint-text"></span>
        </div>
      </div>
    </div>

    <!-- 提醒规则 -->
    <div class="card">
      <div class="card-header">
        <h2>周报提醒</h2>
      </div>
      <div class="card-body">
        <div class="form-grid">
          <div class="form-group">
            <label style="display:flex; align-items:center; gap:8px; cursor:pointer; margin-top:28px">
              <input type="checkbox" name="reminder_enabled" value="1" <%= (settings.reminder_enabled || '0') === '1' ? 'checked' : '' %> style="width:18px;height:18px">
              <span>开启邮件提醒</span>
            </label>
          </div>
          <div class="form-group">
            <label>提醒星期</label>
            <select name="reminder_day">
              <% [['1','周一'],['2','周二'],['3','周三'],['4','周四'],['5','周五'],['6','周六'],['0','周日']].forEach(function(opt) { %>
                <option value="<%= opt[0] %>" <%= String(settings.reminder_day || '5') === opt[0] ? 'selected' : '' %>><%= opt[1] %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label>首次提醒时间</label>
            <input type="time" name="reminder_time" value="<%= settings.reminder_time || '09:00' %>">
          </div>
          <div class="form-group">
            <label>重复提醒间隔（分钟）</label>
            <input type="number" name="reminder_interval_minutes" value="<%= settings.reminder_interval_minutes || '60' %>" min="10">
          </div>
        </div>
        <small class="hint-text">默认周五 9 点提醒；用户本周期本周工作和下周计划都填写后不会再提醒。</small>
      </div>
    </div>

    <!-- 提示词配置 -->
    <div class="card">
      <div class="card-header">
        <h2>AI 提示词</h2>
      </div>
      <div class="card-body">
        <div class="form-group">
          <label>普通 AI 汇总提示词</label>
          <textarea name="ai_prompt" rows="8" placeholder="使用 {{submissions}} 作为提交内容的占位符"><%= settings.ai_prompt || '' %></textarea>
        </div>
        <div class="form-group">
          <label>生成两张表提示词模板</label>
          <textarea name="ai_export_prompt" rows="12" placeholder="使用 {{week_range}}、{{this_week}}、{{next_week}} 作为占位符"><%= settings.ai_export_prompt || '' %></textarea>
          <small class="hint-text">默认要求按项目合并：同一项目只生成一条，多个工作内容合并到一句话里。</small>
        </div>
      </div>
    </div>

  </form>

  <div class="card">
    <div class="card-header">
      <h2>使用说明</h2>
    </div>
    <div class="card-body">
      <ol style="line-height:1.8">
        <li>支持任何 <strong>OpenAI 兼容协议</strong> 的 API（如 DeepSeek、通义千问、自部署 LLM）</li>
        <li>推荐在“多厂家 / 多模型优先级”中按优先级配置多个 API 和模型</li>
        <li>系统会从第一行第一个模型开始尝试，失败后自动切换到下一个模型或厂家</li>
        <li>回到「本周概览」点击 <strong>AI 生成两张表</strong> 按钮即可生成并保存汇总</li>
        <li>提示词模板使用 <code>{{submissions}}</code> 占位符插入员工的周报内容</li>
      </ol>

      <h3 style="margin-top:16px">支持的国内服务商示例：</h3>
      <ul style="line-height:1.8">
        <li><strong>DeepSeek</strong>: <code>https://api.deepseek.com/v1</code>，模型 <code>deepseek-chat</code></li>
        <li><strong>通义千问</strong>: <code>https://dashscope.aliyuncs.com/compatible-mode/v1</code>，模型 <code>qwen-plus</code></li>
        <li><strong>OpenAI</strong>: <code>https://api.openai.com/v1</code>，模型 <code>gpt-4o-mini</code></li>
      </ul>
    </div>
  </div>
</div>
<script>
const initialProviders = <%- JSON.stringify(aiProviders && aiProviders.length ? aiProviders : [{ name: '', baseUrl: '', apiKey: '', modelsText: '', priority: 1 }]) %>;

function addProviderCard(provider = {}) {
  const list = document.getElementById('provider-list');
  const index = list.children.length;
  const card = document.createElement('div');
  card.className = 'provider-card';
  card.innerHTML = `
    <div class="provider-card-head">
      <strong>API 服务商 ${index + 1}</strong>
      <button type="button" class="btn btn-text btn-danger" onclick="removeProviderCard(this)">删除</button>
    </div>
    <div class="form-grid">
      <div class="form-group">
        <label>服务商名称</label>
        <input type="text" name="ai_provider_name" value="${escapeAttr(provider.name || '')}" placeholder="DeepSeek">
      </div>
      <div class="form-group">
        <label>API Base URL</label>
        <input type="text" name="ai_provider_base_url" value="${escapeAttr(provider.baseUrl || '')}" placeholder="https://api.deepseek.com/v1">
      </div>
      <div class="form-group">
        <label>API Key</label>
        <input type="password" name="ai_provider_api_key" value="${escapeAttr(provider.apiKey || '')}" placeholder="sk-...">
      </div>
      <div class="form-group">
        <label>模型顺序</label>
        <input type="text" name="ai_provider_models" value="${escapeAttr(provider.modelsText || '')}" placeholder="deepseek-chat,deepseek-reasoner">
      </div>
      <div class="form-group">
        <label>当前 API 优先级</label>
        <input type="number" name="ai_provider_priority" value="${escapeAttr(provider.priority || index + 1)}" min="1">
      </div>
    </div>
  `;
  list.appendChild(card);
}

function removeProviderCard(btn) {
  btn.closest('.provider-card').remove();
  document.querySelectorAll('.provider-card-head strong').forEach((el, i) => {
    el.textContent = 'API 服务商 ' + (i + 1);
  });
}

function escapeAttr(text) {
  return String(text || '').replace(/[&<>"']/g, ch => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  }[ch]));
}

initialProviders.forEach(provider => addProviderCard(provider));

async function testSmtp() {
  const result = document.getElementById('smtp-test-result');
  result.textContent = '正在发送...';
  const form = document.querySelector('form[action="/admin/settings"]');
  const formData = new FormData(form);
  formData.set('test_email', document.getElementById('test-email').value);
  const payload = Object.fromEntries(formData.entries());
  payload.smtp_secure = form.querySelector('[name="smtp_secure"]').checked ? '1' : '';

  try {
    const resp = await fetch('/admin/settings/test-smtp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await resp.json();
    result.textContent = data.ok ? data.message : data.error;
    result.style.color = data.ok ? '#065f46' : '#991b1b';
  } catch (err) {
    result.textContent = '测试失败：' + err.message;
    result.style.color = '#991b1b';
  }
}
</script>
</body>
</html>
