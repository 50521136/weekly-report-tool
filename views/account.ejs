<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>账号设置</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/nav', {
  navTitle: '账号设置',
  activeNav: 'account',
  adminNav: false,
  backHref: forceSetup ? '' : '/dashboard'
}) %>

<div class="container account-container">
  <% if (flash) { %>
    <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
  <% } %>
  <% if (error) { %>
    <div class="flash flash-error"><%= error %></div>
  <% } %>

  <form method="POST" action="/account" class="card account-card">
    <div class="card-header">
      <h2><%= forceSetup ? '首次登录，请完善账号' : '账号设置' %></h2>
      <% if (forceSetup) { %><span class="badge badge-disabled">必须完成后继续</span><% } %>
    </div>
    <div class="card-body">
      <div class="form-group">
        <label>姓名</label>
        <input type="text" value="<%= currentUser.name %>" readonly>
      </div>
      <div class="form-group">
        <label>邮箱<%= emailRequired ? '（必填）' : '（选填）' %></label>
        <input type="email" name="email" value="<%= currentUser.email || '' %>" placeholder="name@example.com" <%= emailRequired ? 'required' : '' %>>
        <small class="hint-text">用于接收周报填写提醒。</small>
      </div>

      <% if (!currentUser.must_change_password) { %>
        <div class="form-group">
          <label>当前密码</label>
          <input type="password" name="current_password" placeholder="修改密码时填写">
        </div>
      <% } %>
      <div class="form-grid account-password-grid">
        <div class="form-group">
          <label>新密码<%= currentUser.must_change_password ? '（必填）' : '（不修改可留空）' %></label>
          <input type="password" name="new_password" minlength="6" <%= currentUser.must_change_password ? 'required' : '' %>>
        </div>
        <div class="form-group">
          <label>确认新密码</label>
          <input type="password" name="confirm_password" minlength="6" <%= currentUser.must_change_password ? 'required' : '' %>>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="submit" class="btn btn-primary">保存</button>
    </div>
  </form>
</div>
</body>
</html>
